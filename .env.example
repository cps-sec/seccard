# API keys for the LLM-as-judge and the cross-model study.
# Copy this file to `.env` and fill in the keys you need.
# `.env` is gitignored and must never be committed.

# Required for inspect_eval.py (default judge is Claude) and for the
# Claude models in cross_model_eval.py:
ANTHROPIC_API_KEY=

# Optional — only for the closed-source models in cross_model_eval.py:
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Open-weight models in cross_model_eval.py run through a local Ollama
# server (http://localhost:11434) and need no API key.
